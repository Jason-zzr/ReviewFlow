{
  "name": "@reviewflow/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "description": "Local-first content calibration and publishing desk for creators.",
  "author": "ReviewFlow contributors",
  "scripts": {
    "dev": "npm run build --workspace @reviewflow/domain && vite",
    "build": "vue-tsc --noEmit && vite build",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build --workspace @reviewflow/domain && vue-tsc --noEmit && vite build && electron-builder --win nsis",
    "test": "vitest run electron/ai-config-store.test.ts electron/media-library.test.ts electron/workspace-store.test.ts electron/workspace-transfer.test.ts electron/diagnostics-export.test.ts electron/sidecar-request-policy.test.ts src/onboarding-state.test.ts src/publication-jobs.test.ts src/publication-contexts.test.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@reviewflow/domain": "0.1.0",
    "ajv": "^8.20.0",
    "vue": "^3.5.20"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "44.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^3.0.6"
  },
  "build": {
    "appId": "io.reviewflow.desktop",
    "productName": "ReviewFlow",
    "electronDist": "../../node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../services/publisher/dist/reviewflow-sidecar.exe",
        "to": "publisher/reviewflow-sidecar.exe",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../services/publisher/dist/reviewflow-sau.exe",
        "to": "publisher/reviewflow-sau.exe",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../services/publisher/vendor-bin/biliup.exe",
        "to": "publisher/biliup.exe",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "buildResources/icon.png",
      "artifactName": "ReviewFlow-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
